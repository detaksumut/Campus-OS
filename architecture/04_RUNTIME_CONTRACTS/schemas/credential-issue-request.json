{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Credential Issue Request",
  "type": "object",
  "properties": {
    "subjectId": {
      "type": "string",
      "description": "UUID of the identity receiving the credential"
    },
    "credentialType": {
      "type": "string",
      "description": "Type of credential (e.g., BachelorDegree, Transcript)"
    },
    "claims": {
      "type": "object",
      "description": "Key-value pairs representing the assertions made in the credential"
    }
  },
  "required": ["subjectId", "credentialType", "claims"],
  "additionalProperties": false
}
