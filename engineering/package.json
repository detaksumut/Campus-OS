{
  "name": "campus-os-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/foundation/*",
    "packages/platform/*",
    "packages/domains/*",
    "packages/kernel/*",
    "packages/bindings/*",
    "packages/shared",
    "services/*",
    "tools/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:architecture": "ts-node-dev tools/architecture-governance/run-compliance.ts --mode=development",
    "certify:architecture": "ts-node-dev tools/architecture-governance/run-compliance.ts --mode=certification",
    "verify:certificate": "ts-node-dev tools/architecture-governance/run-compliance.ts --verify",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "turbo": "^1.11.2",
    "prettier": "^3.1.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "husky": "^9.0.0",
    "@commitlint/cli": "^18.0.0",
    "@commitlint/config-conventional": "^18.0.0",
    "vitest": "^1.2.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "npm@10.2.0"
}
