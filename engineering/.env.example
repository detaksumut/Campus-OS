# ==========================================
# CAMPUS OS - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. SUPABASE DATABASE & API KEYS
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API & Database
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# 2. POSTGRES CONNECTION STRINGS (Untuk Migrasi Flyway / Prisma / Drizzle)
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 3. SINGLE SIGN-ON (SSO) & AUTHENTICATION
# Mode SSO: 'google' | 'azure' | 'saml' | 'oidc'
VITE_SSO_DEFAULT_PROVIDER="google"
# Domain email resmi kampus untuk SSO Enterprise SAML (contoh: kampus.ac.id)
VITE_SSO_ORGANIZATION_DOMAIN="universitas-anda.ac.id"

# 4. APP URLs
VITE_APP_URL="http://localhost:5173"
VITE_API_URL="http://localhost:3000/api"

# 5. ENVIRONMENT MODE
NODE_ENV="production"
